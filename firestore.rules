rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@tkstationery\\.co\\.tz$'))
      );
    }

    // Phone Index for phone-to-user customer lookup during login
    match /phone_index/{phoneDigits} {
      allow read, write: if true;
    }

    // Users Collection - Resilient Customer Registration & Profiles
    match /users/{userId} {
      allow read, write: if true;

      match /savedProducts/{productId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }

      match /documents/{docId} {
        allow read, write: if true;
      }
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Services Catalog (Printing, Scanning, Copying, Binding, Typing)
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Public / Government Assistance Services
    match /publicServices/{serviceId} {
      allow read, write: if true;
    }

    // Customer Testimonials & Reviews
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Service Requests & Tickets Collection
    match /serviceRequests/{requestId} {
      allow read, write: if true;
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // General Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Documents Collection
    match /documents/{docId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Advertisements & Banners CMS
    match /advertisements/{adId} {
      allow read, write: if true;
    }

    // Payment & Security Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

