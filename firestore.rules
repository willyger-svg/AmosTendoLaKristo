rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHardcodedSuperAdmin() {
      return (
        isSignedIn() && (
          (request.auth.token.email != null && (
            request.auth.token.email.lower() == 'wshavu@gmail.com' ||
            request.auth.token.email.lower() == 'amosstationery@gmail.com' ||
            request.auth.token.email.lower() == 'admin1010@tkstationery.co.tz'
          )) ||
          request.auth.uid == 'admin_1010_master'
        )
      );
    }

    function isSuperAdmin() {
      return isHardcodedSuperAdmin() ||
        (isSignedIn() && request.auth.token.role == 'super_admin');
    }

    // Phone Index for phone-to-user customer lookup during login
    match /phone_index/{phoneDigits} {
      allow read, write: if true;
    }

    // Users Collection - Resilient Customer Registration & Profiles
    match /users/{userId} {
      allow read, write: if true;

      match /savedProducts/{productId} {
        allow read, write: if true;
      }

      match /documents/{docId} {
        allow read, write: if true;
      }
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Service Requests & Tickets Collection
    match /serviceRequests/{requestId} {
      allow read, write: if true;
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // General Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Documents Collection
    match /documents/{docId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Advertisements & Banners CMS
    match /advertisements/{adId} {
      allow read, write: if true;
    }

    // Payment & Security Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

